# Variables necesarias para la guía de documentos con el modelo ONNX.
# Copia este archivo a .env.local o .env.development según tu entorno.

VITE_DOCUMENT_GUIDE_ENABLED=false
# Tolerancia de tamaño entre el documento y el recuadro (fracción 0.01–0.5).
# Un valor mayor que 1 se interpreta como porcentaje (p. ej. 15 = 15 %).
VITE_DOCUMENT_GUIDE_SCALE_TOLERANCE=0.12
VITE_DOCUMENT_MODEL_BASE_URL=https://huggingface.co/chuito1503/noaexport-modelos/resolve/main
VITE_DOCUMENT_MODEL_VERIFY_HASH=true
